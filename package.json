{
  "name": "peek",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @peek/db db:generate",
    "db:migrate:local": "pnpm --filter @peek/api exec wrangler d1 migrations apply peek --local",
    "db:migrate:prod": "pnpm --filter @peek/api exec wrangler d1 migrations apply peek --remote"
  },
  "devDependencies": {
    "@peek/typescript-config": "workspace:*",
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
