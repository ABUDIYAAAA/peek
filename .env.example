# Application Environment
ENVIRONMENT=development
PORT=8787
APP_NAME=peek
APP_URL=http://localhost:8787
LOG_LEVEL=debug

# Security & Auth Secrets (Separate Secrets for Access, Refresh, and Encryption)
JWT_ACCESS_SECRET=development_access_secret_change_me_in_prod_123456
REFRESH_TOKEN_SECRET=development_refresh_secret_change_me_in_prod_789012
ENCRYPTION_SECRET=your_32_character_minimum_encryption_secret_here

# GitHub App OAuth Credentials
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:8787/api/v1/auth/github/callback

# Post-Authentication Frontend Redirect (Optional)
FRONTEND_URL=http://localhost:3000

# Cookie Configuration
COOKIE_ACCESS_NAME=peek_access_token
COOKIE_REFRESH_NAME=peek_refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
