{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "peek-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peek",
      "database_id": "4f3a5fc6-5ea3-4d78-a994-b106c4ae9f29",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
